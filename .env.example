# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Default timezone for NEW chats, and the fallback if a chat has an unknown one
# stored. Each chat can set its own timezone in the bot's settings, which is what
# all of its dates/times then use. IANA name (e.g. Europe/Kyiv, Europe/London, UTC).
TIMEZONE=Europe/Kyiv

# Database URL (SQLite is used by default)
DATABASE_URL=sqlite+aiosqlite:///school_bot.db

# How many days the change history ("📜 История") is kept. 0 = keep forever.
AUDIT_RETENTION_DAYS=180

# --- Telegram Mini App (web) --------------------------------------------
# Only needed when running the web API / auth component (not the bot alone).

# development | production. Gates OpenAPI docs and the Secure cookie flag.
APP_ENV=development

# Public URL of the frontend (dev fallback launch URL).
WEB_APP_URL=http://localhost:5173

# Directory with the built frontend (web/dist) for the API to serve alongside
# /api, so the Mini App is a single origin. Leave the default in development —
# with no index.html there the API runs bare and Vite serves the frontend.
WEB_DIST_DIR=web_dist

# Mini App short name, used to build t.me/<bot>/<short_name>?startapp=<token>.
WEB_APP_SHORT_NAME=

# Secret used to hash launch/session tokens. REQUIRED in production.
SESSION_SECRET=change-me-in-production

# Web session lifetime in seconds (default 7 days).
SESSION_TTL=604800

# Launch-token lifetime in seconds (single-use deep-link token).
LAUNCH_TOKEN_TTL=600

# Max accepted age of Telegram initData in seconds.
INITDATA_MAX_AGE=86400

# How long a verified class membership stays valid without being re-confirmed
# through /web, in seconds (default 30 days). Only the bot can ask Telegram
# whether someone is still in the chat, so web access expires and is renewed by
# running /web again. 0 = never expire.
MEMBERSHIP_MAX_AGE=2592000

# CORS allow-list for the credentialed frontend origin(s), comma-separated.
WEB_ALLOWED_ORIGINS=http://localhost:5173

# Brute-force guard on POST /auth/telegram: max attempts per IP per window.
# Set AUTH_RATE_LIMIT=0 to disable. Process-local (single-host stage 1).
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=60
